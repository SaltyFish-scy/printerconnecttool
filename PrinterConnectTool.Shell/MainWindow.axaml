<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrinterConnectTool.Shell.MainWindow"
        Title="打印机自助连接工具 - 项目来源：Gitee-一条小咸鱼"
        Width="820"
        Height="480"
        MinWidth="700"
        MinHeight="360"
        MaxHeight="660"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height">

    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="打印机自助连接工具"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#007ACC" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,12">
            <TextBlock x:Name="StatusText"
                       Text="正在检测网络环境..."
                       FontSize="14"
                       Foreground="#555555" />
            <TextBlock x:Name="WorkplaceText"
                       Text=""
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#2E8B57"
                       IsVisible="False" />
            <TextBlock x:Name="HintText"
                       Text=""
                       FontSize="13"
                       Foreground="#333333"
                       IsVisible="False" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          MaxHeight="240">
                <WrapPanel x:Name="PrintersPanel"
                           Orientation="Horizontal"
                           HorizontalAlignment="Left" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="安装日志"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#333333"
                   Margin="0,0,0,6" />

        <Border Grid.Row="4"
                Background="#FFFFFF"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8"
                MinHeight="80">
            <ScrollViewer x:Name="LogScrollViewer"
                          VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         IsTabStop="False"
                         Focusable="False"
                         CaretBrush="Transparent"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         FontFamily="Consolas, monospace"
                         FontSize="12"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#222222" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
